DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
UPLOAD_DIR="uploads"
EMAIL_NOTIFICATIONS_ENABLED="false"
# console = log to server output; file = write .eml files to EMAIL_OUTBOX_DIR
EMAIL_TRANSPORT="console"
EMAIL_OUTBOX_DIR="outbox"
EMAIL_FROM="TestBoard <no-reply@testboard.local>"
# Base URL used for links in emails
APP_URL="http://localhost:3000"
# Microsoft Entra ID sign-in (optional). Register an app in Entra ID with redirect URI {APP_URL}/auth/microsoft/callback.
MS_ENTRA_TENANT_ID=""
MS_ENTRA_CLIENT_ID=""
MS_ENTRA_CLIENT_SECRET=""
# Only these e-mail domains may sign in with Microsoft, e.g. "sariba.no,sariba.se,sariba.es"
MS_ENTRA_ALLOWED_DOMAINS=""
# Create accounts automatically on first Microsoft sign-in (in this organisation)
MS_ENTRA_AUTO_CREATE="true"
MS_ENTRA_ORGANIZATION="Sariba"
